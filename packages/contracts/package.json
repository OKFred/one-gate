{
  "name": "@hodor/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./backend": {
      "types": "./dist/backend.d.ts",
      "import": "./dist/backend.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "import": "./dist/frontend.js"
    },
    "./resources": {
      "types": "./dist/generated/resources/index.d.ts",
      "import": "./dist/generated/resources/index.js"
    },
    "./resources/*": {
      "types": "./dist/generated/resources/*.d.ts",
      "import": "./dist/generated/resources/*.js"
    },
    "./manifest": {
      "types": "./dist/generated/manifest.d.ts",
      "import": "./dist/generated/manifest.js"
    },
    "./schema": "./schema/crud-resource.schema.json"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "validate": "tsx scripts/validate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json --noEmit"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@types/node": "^22.13.10",
    "json-schema-to-ts": "^3.1.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "vitest": "~4.1.8"
  }
}
