{
  "$schema": "../../../../schema/crud-resource.schema.json",
  "version": 1,
  "resource": "admin/base/sys_config",
  "permissions": "none",
  "operations": {
    "get": false
  },
  "cardMode": "custom",
  "filters": {
    "keyword": { "enabled": false },
    "sortableFields": ["id", "namespace", "configKey", "isEnabled", "isPrimary", "createTimeUtc"],
    "showSortControls": false
  },
  "fields": [
    {
      "name": "id",
      "preset": "id",
      "ui": {
        "table": { "show": true, "width": 80 },
        "card": false
      }
    },
    {
      "name": "namespace",
      "schema": { "type": "string", "description": "命名空间" },
      "requiredOn": ["add", "list", "detail"],
      "in": { "list": true, "detail": true, "add": true, "update": false, "listFilter": true },
      "ui": {
        "labelKey": "admin.base.namespace",
        "table": { "show": true, "renderer": "enumChip", "hashColor": true, "variant": "outlined" },
        "card": false,
        "filter": false,
        "form": {
          "show": true,
          "widget": "select",
          "disabledWhen": "edit",
          "defaultValue": "",
          "optionsSource": {
            "url": "/api/v1/admin/base/sys_config/namespaces",
            "labelField": "namespace",
            "valueField": "namespace"
          }
        }
      }
    },
    {
      "name": "configKey",
      "schema": { "type": "string", "description": "配置键" },
      "requiredOn": ["add", "list", "detail"],
      "ui": {
        "labelKey": "admin.base.configKey",
        "table": { "show": true, "renderer": "text" },
        "card": false,
        "form": { "show": true, "widget": "text", "defaultValue": "" }
      }
    },
    {
      "name": "isEnabled",
      "preset": "isEnabled",
      "in": { "list": true, "detail": true, "add": true, "update": true, "listFilter": true },
      "ui": {
        "labelKey": "common.isEnabled",
        "table": { "show": true, "titleKey": "common.isEnabled", "width": 100, "renderer": "booleanSwitch" },
        "card": false,
        "filter": false,
        "form": { "labelKey": "common.isEnabled", "defaultValue": true }
      }
    },
    {
      "name": "isPrimary",
      "schema": { "type": "boolean", "description": "是否为主配置" },
      "requiredOn": ["add", "list", "detail"],
      "ui": {
        "labelKey": "admin.base.isPrimary",
        "table": {
          "show": true,
          "width": 120,
          "renderer": "booleanChip",
          "hideWhenFalse": true,
          "trueLabelKey": "column.yes",
          "trueColor": "success",
          "fallback": ""
        },
        "card": false,
        "form": { "show": true, "widget": "switch", "defaultValue": false }
      }
    },
    {
      "name": "remark",
      "preset": "remark",
      "in": { "list": true, "detail": true, "add": true, "update": true },
      "ui": {
        "table": false,
        "card": false,
        "form": { "widget": "text", "valueTransform": "emptyToNull", "defaultValue": null }
      }
    },
    {
      "name": "configValue",
      "schema": { "type": "object", "additionalProperties": true, "description": "配置值JSON" },
      "requiredOn": ["add", "list", "detail"],
      "ui": {
        "labelKey": "admin.base.configValue",
        "table": false,
        "card": false,
        "form": {
          "show": true,
          "widget": "dynamicSubForm",
          "defaultValue": {},
          "dynamicSubForm": {
            "schemaUrl": "/api/v1/admin/base/sys_config/schema",
            "namespaceField": "namespace",
            "valueField": "configValue",
            "titleKey": "admin.base.configValue"
          }
        }
      }
    },
    {
      "name": "createTimeUtc",
      "preset": "createTimeUtc",
      "ui": {
        "table": { "show": true, "width": 180, "renderer": "datetime", "fallback": "--" }
      }
    }
  ]
}
