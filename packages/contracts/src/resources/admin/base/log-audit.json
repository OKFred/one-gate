        "card": { "role": "content", "labelKey": "log.beforeData" }
      }
    },
    {
      "name": "afterData",
      "schema": {
        "type": ["object", "array", "string", "number", "boolean", "null"],
        "nullable": true,
        "additionalProperties": true,
        "description": "变更后数据"
      },
      "in": { "list": true, "detail": true },
      "ui": {
        "labelKey": "log.afterData",
