{
  "$schema": "../../../../schema/crud-resource.schema.json",
  "version": 1,
  "resource": "admin/base/log-audit",
  "mountRoute": false,
  "embedded": true,
  "readonly": true,
  "auditFields": false,
  "permissions": "none",
  "permissionNamespace": "admin.base.log",
  "api": {
