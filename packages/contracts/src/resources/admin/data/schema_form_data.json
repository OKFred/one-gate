{
  "$schema": "../../../../schema/crud-resource.schema.json",
  "version": 1,
  "resource": "admin/data/schema_form_data",
  "permissions": "none",
  "auditFields": true,
  "api": {
    "summaries": {
      "list": "获取表单数据列表",
      "get": "获取表单数据详情",
      "delete": "删除表单数据"
    }
  },
  "operations": {
    "list": true,
    "listAll": false,
    "get": true,
    "add": false,
    "update": false,
    "delete": true
  },
  "filters": {
    "keyword": { "enabled": false },
    "sortableFields": ["id", "formCode", "businessId", "createTimeUtc"],
    "showSortControls": false,
    "defaultSort": {
      "orderBy": "id",
      "descend": true
    }
  },
  "fields": [
    {
      "name": "id",
      "preset": "id",
      "in": { "list": true, "detail": true, "add": false, "update": false, "get": true, "listAll": false },
      "ui": {
        "labelKey": "columns.id",
        "table": { "show": true, "renderer": "text" },
        "card": { "role": "subtitle", "labelKey": "columns.id" }
      }
    },
    {
      "name": "formCode",
      "schema": {
        "type": "string",
        "description": "关联的表单 Code",
        "maxLength": 100
      },
      "requiredOn": ["list", "detail"],
      "in": { "list": true, "detail": true, "add": false, "update": false, "listAll": false, "listFilter": true },
      "ui": {
        "labelKey": "schemaFormData.filter.formCode",
        "table": { "show": true },
        "card": { "role": "title", "template": "${formCode} (Biz ID: ${businessId})" },
        "filter": {
          "show": true,
          "type": "text",
          "placeholderKey": "schemaFormData.filter.formCodePlaceholder",
          "transform": "emptyToUndefined"
        },
        "form": false
      }
    },
    {
      "name": "businessId",
      "schema": {
        "type": "number",
        "description": "关联的业务记录 ID"
      },
      "requiredOn": ["list", "detail"],
      "in": { "list": true, "detail": true, "add": false, "update": false, "listAll": false, "listFilter": true },
      "ui": {
        "labelKey": "schemaFormData.filter.businessId",
        "table": { "show": true },
        "card": false,
        "filter": false,
        "form": false
      }
    },
    {
      "name": "dataContent",
      "schema": {
        "type": "string",
        "description": "用户提交的 JSON 数据内容（序列化字符串）"
      },
      "requiredOn": ["list", "detail"],
      "in": { "list": true, "detail": true, "add": false, "update": false, "listAll": false },
      "ui": {
        "labelKey": "schemaFormData.dataContent",
        "table": { "show": true, "renderer": "text", "truncate": 50 },
        "card": { "role": "content", "labelKey": "schemaFormData.dataContent" },
        "form": false
      }
    },
    {
      "name": "creatorName",
      "schema": {
        "type": ["string", "null"],
        "nullable": true,
        "description": "创建人姓名"
      },
      "requiredOn": ["list", "detail"],
      "in": { "list": true, "detail": true, "add": false, "update": false, "listAll": false },
      "ui": { "table": false, "card": false, "form": false }
    },
    {
      "name": "updaterName",
      "schema": {
        "type": ["string", "null"],
        "nullable": true,
        "description": "修改人姓名"
      },
      "requiredOn": ["list", "detail"],
      "in": { "list": true, "detail": true, "add": false, "update": false, "listAll": false },
      "ui": { "table": false, "card": false, "form": false }
    }
  ]
}
