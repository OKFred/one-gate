{
  "$schema": "../../../../schema/crud-resource.schema.json",
  "version": 1,
  "resource": "admin/system/permission",
  "auditFields": true,
  "api": {
    "summaries": {
      "list": "获取权限列表",
      "listAll": "获取所有权限（不分页）",
      "get": "获取权限",
      "add": "添加权限",
      "update": "更新权限",
      "delete": "删除权限"
    }
  },
  "operations": {
    "list": true,
    "listAll": true,
    "get": true,
    "add": true,
    "update": true,
    "delete": true
  },
  "filters": {
    "keyword": {
      "enabled": true,
      "labelKey": "filter.keyword",
      "placeholderKey": "filter.keywordLabel"
    },
    "sortableFields": ["id", "code", "name", "category", "isEnabled", "createTimeUtc"],
    "showSortControls": false,
    "defaultSort": {
      "orderBy": "id",
      "descend": true
    }
  },
  "fields": [
    {
      "name": "id",
      "preset": "id",
      "in": { "list": true, "detail": true, "add": false, "update": true, "get": true, "listAll": true },
      "ui": {
        "labelKey": "columns.id",
        "table": { "show": true, "renderer": "text" },
        "card": false
      }
    },
    {
      "name": "code",
      "schema": {
        "type": "string",
        "description": "权限代码，唯一标识",
        "examples": ["user:read", "file:write:own"],
        "maxLength": 100
      },
      "requiredOn": ["add", "list", "detail", "get"],
      "in": { "list": true, "detail": true, "add": true, "update": true, "listAll": true, "listFilter": true },
      "ui": {
        "labelKey": "permission.code",
        "table": { "show": true },
        "card": { "role": "subtitle", "labelKey": "permission.code" },
        "filter": false,
        "form": { "show": true, "widget": "text", "required": true, "defaultValue": "" }
      }
    },
    {
      "name": "name",
      "schema": {
        "type": "string",
        "description": "权限名称",
        "examples": ["查看用户", "编辑文件"],
        "maxLength": 100
      },
      "requiredOn": ["add", "list", "detail"],
      "in": { "list": true, "detail": true, "add": true, "update": true, "listAll": true, "listFilter": true },
      "ui": {
        "labelKey": "permission.name",
        "table": { "show": true },
        "card": { "role": "title", "template": "${name}" },
        "filter": false,
        "form": { "show": true, "widget": "text", "required": true, "defaultValue": "" }
      }
    },
    {
      "name": "category",
      "schema": {
        "type": "string",
        "enum": ["action"],
        "description": "权限类别：action-动作"
      },
      "requiredOn": ["add", "list", "detail"],
      "in": { "list": true, "detail": true, "add": true, "update": true, "listAll": true, "listFilter": true },
      "ui": {
        "labelKey": "permission.category",
        "table": {
          "show": true,
          "renderer": "enumText",
          "options": [
            { "value": "menu", "labelKey": "permission.category.menu" },
            { "value": "button", "labelKey": "permission.category.button" },
            { "value": "api", "labelKey": "permission.category.api" },
            { "value": "action", "labelKey": "permission.category.action" }
          ]
        },
        "card": { "role": "content", "labelKey": "permission.category" },
        "filter": false,
        "form": {
          "show": true,
          "widget": "select",
          "required": true,
          "defaultValue": "action",
          "options": [{ "value": "action", "labelKey": "permission.category.action" }]
        }
      }
    },
    {
      "name": "resource",
      "schema": {
        "type": ["string", "null"],
        "nullable": true,
        "description": "资源路径",
        "examples": ["/api/users/:id", "/dashboard/users"],
        "maxLength": 500
      },
      "requiredOn": ["add", "list", "detail"],
      "in": { "list": true, "detail": true, "add": true, "update": true, "listAll": true },
      "ui": {
        "labelKey": "permission.resource",
        "table": { "show": true, "fallback": "--" },
        "card": { "role": "content", "labelKey": "permission.resource", "fallback": "--" },
        "form": {
          "show": true,
          "widget": "text",
          "placeholder": "/api/example",
          "defaultValue": ""
        }
      }
    },
    {
      "name": "business",
      "schema": {
        "type": ["string", "null"],
        "nullable": true,
        "description": "业务标识"
      },
      "requiredOn": ["add", "list", "detail"],
      "in": { "list": true, "detail": true, "add": true, "update": true, "listAll": true },
      "ui": {
        "labelKey": "permission.business",
        "table": { "show": true, "fallback": "--" },
        "card": { "role": "content", "labelKey": "permission.business", "fallback": "--" },
        "form": { "show": true, "widget": "text", "defaultValue": null }
      }
    },
    {
      "name": "isEnabled",
      "preset": "isEnabled",
      "in": { "list": true, "detail": true, "add": true, "update": true, "listAll": true, "listFilter": true },
      "ui": {
        "labelKey": "status.enabled",
        "table": {
          "show": true,
          "renderer": "booleanChip",
          "trueLabelKey": "status.enabled",
          "falseLabelKey": "status.disabled",
          "trueColor": "success",
          "falseColor": "error",
          "variant": "outlined"
        },
        "card": {
          "role": "tag",
          "trueLabelKey": "status.enabled",
          "falseLabelKey": "status.disabled",
          "trueColor": "success",
          "falseColor": "error"
        },
        "filter": false,
        "form": { "show": true, "widget": "switch", "defaultValue": true }
      }
    },
    {
      "name": "createTimeUtc",
      "preset": "createTimeUtc",
      "requiredOn": ["list", "detail"],
      "in": { "list": true, "detail": true, "add": false, "update": false, "listAll": false },
      "ui": {
        "labelKey": "columns.createTime",
        "table": { "show": true, "renderer": "datetime", "fallback": "--" },
        "card": false
      }
    },
    {
      "name": "remark",
      "preset": "remark",
      "requiredOn": ["add", "list", "detail"],
      "in": { "list": true, "detail": true, "add": true, "update": true, "listAll": true },
      "ui": {
        "table": false,
        "card": false,
        "form": {
          "show": true,
          "widget": "textarea",
          "rows": 3,
          "maxLength": 500,
          "showCharCount": true,
          "valueTransform": "emptyToNull",
          "defaultValue": null
        }
      }
    }
  ]
}
