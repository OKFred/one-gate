{
  "journeys": [
    {
      "name": "登录与 TOTP 二次验证门禁",
      "entry": "/login",
      "flow": "/login (密码 / SSO /sso/callback) -> TOTP Gate 验证 -> /home",
      "e2e": [
        "platform/e2e/auth/auth-ui.spec.ts",
        "platform/e2e/platform-errors/login-limit.spec.ts"
      ]
    },
    {
      "name": "工作台首页与 Cloudflare 状态摘要",
      "entry": "/home",
      "flow": "/home 快捷入口卡片 & Cloudflare 单行摘要 (仅 >=80% 预警展开) -> /home?view=usage",
      "e2e": [
        "platform/e2e/cloudflare-home/home-summary.spec.ts",
        "platform/e2e/cloudflare-home/cloudflare-home.spec.ts",
        "platform/e2e/cloudflare-home/usage-trend-math.spec.ts"
      ]
    },
    {
      "name": "个人日程与到期提醒",
      "entry": "/calendar",
      "flow": "/home 日历快捷入口 -> /calendar 新建/编辑/确认提醒 & 订阅链接",
      "e2e": [
        "platform/e2e/calendar/calendar.spec.ts",
        "platform/e2e/calendar/subscription.spec.ts"
      ]
    },
    {
      "name": "天地图空间工作区",
      "entry": "/home?view=map",
      "flow": "/home 天地图卡片 -> /home?view=map 底图切换/注记图层加载",
      "e2e": [
        "platform/e2e/tianditu/tianditu.spec.ts"
      ]
    },
    {
      "name": "多模型 AI 对话助手",
      "entry": "/admin/ai/chat",
      "flow": "/admin/ai/config 配置模型 -> /home AI 卡片或侧边栏 -> /admin/ai/chat 对话与模型切换",
      "e2e": [
        "platform/e2e/cloudflare-home/cloudflare-home.spec.ts"
      ]
    },
    {
      "name": "契约驱动 CRUD（列表/筛选/表单/详情）",
      "entry": "/admin/base/webhook_config",
      "flow": "buildContractRoutes 自动挂载 -> ContractCrudPage -> AJV (含 ajv-formats) 提交或 ContractDetailDialog",
      "e2e": [
        "platform/e2e/contract-crud/contract-crud.spec.ts",
        "platform/e2e/delete-undo/crud-resource-switch.spec.ts",
        "platform/e2e/api-token/create-reveal.spec.ts"
      ]
    },
    {
      "name": "软删除与 30 天回收站撤销",
      "entry": "/admin/system/role",
      "flow": "/admin/system/{role,department} 删除 -> 撤销 Snackbar 或 /admin/recycle-bin 恢复/彻底清除",
      "e2e": [
        "platform/e2e/delete-undo/delete-undo.spec.ts",
        "platform/e2e/delete-undo/role-delete-undo.spec.ts",
        "platform/e2e/recycle-bin/recycle-bin.spec.ts",
        "platform/e2e/delete-undo/api-failure.spec.ts"
      ]
    },
    {
      "name": "企业多租户与资产台账 (Module Federation)",
      "entry": "/enterprise/asset",
      "flow": "admin Host MicroApp -> gate-enterprise /enterprise/tenant, /enterprise/asset, /enterprise/organization/attendance",
      "e2e": [
        "platform/e2e/enterprise-assets/assets.spec.ts"
      ]
    },
    {
      "name": "个人资产空间与偏好设置 (Module Federation)",
      "entry": "/personal/asset",
      "flow": "admin Host MicroApp -> gate-personal /personal/asset, /personal/base/preference & 个人档案",
      "e2e": [
        "platform/e2e/personal-assets.spec.ts",
        "platform/e2e/personal-assets-model.spec.ts"
      ]
    },
    {
      "name": "移动端设备运维与异步任务运行时",
      "entry": "/admin/mobile/async-task",
      "flow": "/admin/mobile/device (WebSocket Ops) -> /admin/mobile/app -> /admin/mobile/async-task 下发与状态轮询",
      "e2e": [
        "platform/e2e/mobile-task-runtime/device-tasks.spec.ts",
        "platform/e2e/smoke/hodor-device.spec.ts"
      ]
    }
  ],
  "routeLabels": {
    "/login": "登录页",
    "/sso/callback": "身份中心 SSO 回调",
    "/calendar": "个人日程与提醒",
    "/admin/mail": "邮件模块根重定向",
    "/admin/voice": "实时通话根重定向",
    "/enterprise/home": "企业端独立首页",
    "/personal/home": "个人端独立首页"
  },
  "specRouteHints": {
    "platform/e2e/api-token/create-reveal.spec.ts": ["/admin/system/api-token"],
    "platform/e2e/auth/auth-ui.spec.ts": ["/login", "/sso/callback", "/home"],
    "platform/e2e/calendar/calendar.spec.ts": ["/calendar", "/home"],
    "platform/e2e/calendar/subscription.spec.ts": ["/calendar"],
    "platform/e2e/cloudflare-home/cloudflare-home.spec.ts": ["/home", "/admin/ai/chat"],
    "platform/e2e/cloudflare-home/home-summary.spec.ts": ["/home"],
    "platform/e2e/cloudflare-home/usage-trend-math.spec.ts": ["/home"],
    "platform/e2e/contract-crud/contract-crud.spec.ts": [
      "/admin/ai/config",
      "/admin/base/webhook_config",
      "/admin/mail/log",
      "/admin/base/log"
    ],
    "platform/e2e/delete-undo/api-failure.spec.ts": ["/admin/system/department", "/admin/system/role"],
    "platform/e2e/delete-undo/crud-resource-switch.spec.ts": ["/admin/system/role"],
    "platform/e2e/delete-undo/delete-undo.spec.ts": ["/admin/system/department"],
    "platform/e2e/delete-undo/role-delete-undo.real.spec.ts": ["/admin/system/role"],
    "platform/e2e/delete-undo/role-delete-undo.spec.ts": ["/admin/system/role"],
    "platform/e2e/enterprise-assets/assets.spec.ts": ["/enterprise/asset", "/enterprise/tenant"],
    "platform/e2e/mobile-task-runtime/device-tasks.spec.ts": ["/admin/mobile/async-task", "/admin/mobile/device"],
    "platform/e2e/personal-assets-model.spec.ts": ["/personal/asset"],
    "platform/e2e/personal-assets.spec.ts": ["/personal/asset"],
    "platform/e2e/platform-errors/login-limit.spec.ts": ["/login"],
    "platform/e2e/platform-errors/platform-errors.spec.ts": [],
    "platform/e2e/recycle-bin/recycle-bin.spec.ts": ["/admin/recycle-bin"],
    "platform/e2e/smoke/hodor-device.spec.ts": ["/admin/mobile/device"],
    "platform/e2e/tianditu/tianditu.spec.ts": ["/home"]
  }
}
