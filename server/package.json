{
  "name": "mail",
  "version": "1.0.1",
  "description": "send emails via nodemailer",
  "main": "./src/index.js",
  "type": "module",
  "scripts": {
    "dev": "npx tsx --watch -r dotenv/config ./src/index.ts",
    "build": "npx tsgo && npx tsc-alias",
    "build:docker": "docker build -t registry.cn-hangzhou.aliyuncs.com/one-registry/base-mail-service:1.0.1 . && docker push registry.cn-hangzhou.aliyuncs.com/one-registry/base-mail-service:1.0.1",
    "start:ts": "node ./src/index.ts",
    "start": "node ./dist/index.js",
    "test:generate": "pnpm exec openapi-generator-cli generate -i http://localhost:3000/doc.json -g javascript -o ./test/openapi-client",
    "test:run": "cd ./test/openapi-client && npm install && pnpm run test"
  },
  "keywords": [],
  "author": "FZ",
  "license": "MIT",
  "repository": {},
  "exports": "./dist/index.mjs",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@hono/node-server": "^1.13.8",
    "@hono/swagger-ui": "^0.5.1",
    "@hono/zod-openapi": "^0.19.2",
    "@scalar/hono-api-reference": "^0.9.1",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.44.4",
    "hono": "^4.7.5",
    "hono-openapi": "^0.4.6",
    "hono-pino": "^0.10.2",
    "http-status-codes": "^2.3.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.3",
    "openapi3-ts": "^4.5.0",
    "pako": "^2.1.0",
    "pino": "^9.9.0",
    "pino-roll": "^3.1.0",
    "xmldom": "^0.6.0",
    "xpath": "^0.0.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@libsql/client": "^0.15.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pako": "^2.0.3",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript/native-preview": "7.0.0-dev.20250623.1",
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.22.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "json-schema-to-ts": "^3.1.1",
    "prettier": "^3.5.3",
    "tsc-alias": "^1.8.11",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "better-sqlite3",
      "bufferutil",
      "esbuild",
      "sqlite3",
      "utf-8-validate"
    ]
  }
}
