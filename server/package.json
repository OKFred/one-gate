{
  "name": "rbac-server",
  "version": "1.0.1",
  "description": "rbac server",
  "main": "./src/node.js",
  "type": "module",
  "scripts": {
    "dev": "npx tsx --watch --env-file=.dev.vars ./src/node.ts",
    "debug": "npx tsx --inspect-brk --env-file=.dev.vars ./src/node.ts",
    "build": "npx tsgo && npx tsc-alias",
    "start": "node ./dist/node.js",
    "visualize": "npx tsx scripts/dependency-visualize.ts",
    "worker:dev": "npx wrangler dev",
    "worker:types": "npx wrangler types",
    "db:init": "npx tsx -r dotenv/config ./src/db/initTable.ts",
    "format": "prettier --write .",
    "lint": "eslint . --fix"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "FZ",
  "license": "MIT",
  "repository": {},
  "exports": "./dist/node.mjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "@aws-sdk/s3-request-presigner": "^3.1029.0",
    "@cfworker/json-schema": "^4.1.1",
    "@hono/node-server": "^1.13.8",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    "@scalar/hono-api-reference": "^0.10.7",
    "cache-manager": "^7.2.8",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12",
    "hono-openapi": "^1.3.0",
    "hono-pino": "^0.10.3",
    "http-status-codes": "^2.3.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.3",
    "openapi3-ts": "^4.5.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "worker-mailer": "^1.2.1",
    "xmldom": "^0.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@eslint/js": "^9.22.0",
    "@libsql/client": "^0.15.12",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript/native-preview": "7.0.0-dev.20250623.1",
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.22.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "json-schema-to-ts": "^3.1.1",
    "lint-staged": "^17.0.2",
    "prettier": "^3.5.3",
    "tsc-alias": "^1.8.11",
    "typescript": "^5.8.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.96.0"
  }
}
