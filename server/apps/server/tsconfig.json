{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "strict": false,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true,
    "resolveJsonModule": true,
    "lib": ["ESNext"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@hodor/core/*": ["../../packages/core/src/*"],
      "@hodor/admin/*": ["../../packages/admin/src/*"],
      "@hodor/enterprise/*": ["../../packages/enterprise/src/*"],
      "@hodor/personal/*": ["../../packages/personal/src/*"]
    }
  },
  "include": ["src/**/*", "worker-configuration.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "test/**/**",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "tsc-alias": {
    "verbose": true,
    "resolveFullPaths": true
  }
}
