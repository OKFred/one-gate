# 数据库配置
DB_FILE_NAME=file:./local.db
# DB_FILE_NAME=:memory:

# 可选 PostgreSQL（仅切换部署配置；支持范围与迁移步骤见 docs/postgresql.md）
# DATABASE_BACKEND=postgresql
# DATABASE_URL=postgresql://APPLICATION_USER:PERCENT_ENCODED_PASSWORD@DATABASE_HOST:5432/postgres
# PG_SCHEMA=one_gate
# PG_SSL_CA_FILE=C:/private/postgresql-ca.crt

# JWT 配置
JWT_SECRET=your-secret-key-here-please-change-in-production

# 移动设备敏感数据 AES-256-GCM 密钥（32 字节 Base64）
# 生成示例：openssl rand -base64 32；生产环境必须通过密钥管理/Worker secret 注入
MOBILE_SENSITIVE_DATA_KEY=

# one-autojs6 发布流水线专用令牌；仅允许准备/完成不可变客户端制品上传
MOBILE_RELEASE_PUBLISH_TOKEN=

# 服务器配置
PORT=8787
# HOST=127.0.0.1
NODE_ENV=development
LOCALE=zh-CN
BASE_API_PATH=/api/v1
STATIC_FILE_PATH=

# 可选私人日历只读 ICS：固定 HTTPS API origin，不含路径/查询；留空时不可生成或拉取
# 外部客户端须能访问精确 /calendar-subscription.ics 路径；其余业务接口仍保留登录/TOTP
CALENDAR_SUBSCRIPTION_ORIGIN=

# 超级管理员配置
# 首次启动时会自动创建超级管理员账号
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=replace-with-a-unique-local-password

# 测试用邮件配置（可选，用于集成测试真实发送）
# 本地开发时将值填入 .dev.vars（已被 .gitignore 排除）
# 公共 CI 不提供真实邮件凭证；需要真实测试时在私有环境中注入
TEST_MAIL_ADDRESS=
TEST_MAIL_PASSWORD=
TEST_MAIL_HOST=smtp.example.com
TEST_MAIL_PORT=465
TEST_MAIL_WRONG_ADDRESS=wrong@nonexist.example.com
TEST_MAIL_WRONG_PASSWORD=wrong-password
TEST_MAIL_RECEIVER=test-receiver@example.com

# Cloudflare 部署配置（主要用于 CI/CD，本地手动部署时可选用）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 可选账号用量面板：两枚限定同一账号的 account-owned 只读 Token；与部署/AI凭据独立
CF_USAGE_ACCOUNT_ID=
# Account Analytics: Read
CF_USAGE_ANALYTICS_TOKEN=
# Billing: Read
CF_USAGE_BILLING_TOKEN=

# 可选天地图浏览器 Key（32 位十六进制）；仅登录用户接口下发，不使用 VITE_ 构建变量
# Node 使用本地忽略的环境文件；Worker 生产使用 TIANDITU_BROWSER_KEY Secret
TIANDITU_BROWSER_KEY=

# Hodor 身份事务 AES-256-GCM 根密钥（32 字节 Base64）
# 生成示例：openssl rand -base64 32；生产环境必须通过 Worker secret 注入。
HODOR_AUTH_MASTER_KEY=

# 部署级 TOTP 门禁密钥（20 字节 Base32）；仅通过本地忽略文件或 Worker secret 注入
HODOR_TOTP_GATE_SECRET=

# 浏览器跨域白名单，逗号分隔并精确匹配 Origin
HODOR_ALLOWED_WEB_ORIGINS=http://localhost:5173
