# 数据库配置
DB_FILE_NAME=file:/data.db
# DB_FILE_NAME=:memory:

# JWT 配置
JWT_SECRET=your-secret-key-here-please-change-in-production

# 移动设备敏感数据 AES-256-GCM 密钥（32 字节 Base64）
# 生成示例：openssl rand -base64 32；生产环境必须通过密钥管理/Worker secret 注入
MOBILE_SENSITIVE_DATA_KEY=

# one-autojs6 发布流水线专用令牌；仅允许准备/完成不可变客户端制品上传
MOBILE_RELEASE_PUBLISH_TOKEN=

# 服务器配置
PORT=8787
NODE_ENV=development
LOCALE=zh-CN
BASE_API_PATH=/api/v1
STATIC_FILE_PATH=

# 超级管理员配置
# 首次启动时会自动创建超级管理员账号
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=Admin@123456

# 测试用邮件配置（可选，用于集成测试真实发送）
# 本地开发时将值填入 .dev.vars（已被 .gitignore 排除）
# CI/CD 中通过 GitHub Actions Secrets 注入
TEST_MAIL_ADDRESS=
TEST_MAIL_PASSWORD=
TEST_MAIL_HOST=smtp.example.com
TEST_MAIL_PORT=465
TEST_MAIL_WRONG_ADDRESS=wrong@nonexist.example.com
TEST_MAIL_WRONG_PASSWORD=wrong-password
TEST_MAIL_RECEIVER=test-receiver@example.com

# Cloudflare 部署配置（主要用于 CI/CD，本地手动部署时可选用）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

GH_CLIENT_ID=
GH_CLIENT_SECRET=
GH_ORG_NAME=

# 飞书企业自建应用 OAuth（本地 Worker 请将真实值放入未跟踪的 .dev.vars）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 逗号分隔的飞书 tenant_key 白名单
FEISHU_ALLOWED_TENANT_KEYS=

# 逗号分隔的 OAuth 前端回调 Origin，例如 http://localhost:5173,https://gate.example.com
OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:5173
# OAuth 档案与凭证 AES-256-GCM 密钥（32 字节 Base64）
# 生成示例：openssl rand -base64 32；生产环境必须通过 Worker secret 注入
OAUTH_SENSITIVE_DATA_KEY=

# one-sso OIDC 客户端（每个部署环境独立配置）
SSO_ISSUER=https://sso.example.com
SSO_CLIENT_ID=
SSO_AUDIENCE=
SSO_ALLOWED_TENANT_ID=
# 逗号分隔且精确匹配；生产仅允许 HTTPS，本地可使用 localhost
SSO_ALLOWED_REDIRECT_URIS=http://localhost:5173/sso/callback?intent=login,http://localhost:5173/sso/callback?intent=bind

# 部署级 TOTP 门禁密钥（20 字节 Base32）；仅通过本地忽略文件或 Worker secret 注入
HODOR_TOTP_GATE_SECRET=

# 浏览器跨域白名单，逗号分隔并精确匹配 Origin
HODOR_ALLOWED_WEB_ORIGINS=http://localhost:5173
