# 数据库配置
DB_FILE_NAME=file:/data.db
# DB_FILE_NAME=:memory:

# JWT 配置
JWT_SECRET=your-secret-key-here-please-change-in-production

# 服务器配置
PORT=8787
NODE_ENV=development
LOCALE=zh-CN
BASE_API_PATH=/api/v1
STATIC_FILE_PATH=

# 超级管理员配置
# 首次启动时会自动创建超级管理员账号
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=Admin@123456

# 引导令牌（用于数据库初始化）
X_INIT_TOKEN=your-random-setup-token-here

# 测试用邮件配置（可选，用于集成测试真实发送）
# 本地开发时将值填入 .dev.vars（已被 .gitignore 排除）
# CI/CD 中通过 GitHub Actions Secrets 注入
TEST_MAIL_ADDRESS=
TEST_MAIL_PASSWORD=
TEST_MAIL_HOST=smtp.example.com
TEST_MAIL_PORT=465
TEST_MAIL_WRONG_ADDRESS=wrong@nonexist.example.com
TEST_MAIL_WRONG_PASSWORD=wrong-password
TEST_MAIL_RECEIVER=test-receiver@example.com

# Cloudflare 部署配置（主要用于 CI/CD，本地手动部署时可选用）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
