/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "https://cdn.jsdelivr.net/npm/wrangler/config-schema.json",
  "name": "hodor",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],

  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use `wrangler secret put <KEY>` for sensitive values (JWT_SECRET, passwords etc.)
   */
  "vars": {
    "NODE_ENV": "production",
    "BASE_API_PATH": "/api/v1",
    "LOCALE": "zh-CN",
    "VERSION": "20260604152404-2a47509d",
  },

  /**
   * D1 Database Binding
   * https://developers.cloudflare.com/d1/
   * Run: wrangler types  (after adding this) to regenerate worker-configuration.d.ts
   */
  "d1_databases": [
    {
      "binding": "DB", // Variable name used in worker: c.env.DB
      "database_name": "hodor_db",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],

  /**
   * KV Namespace Binding
   * https://developers.cloudflare.com/kv/
   */
  "kv_namespaces": [
    {
      "binding": "KV", // Variable name used in worker: c.env.KV
      "id": "00000000000000000000000000000000",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "hodor",
      "binding": "BUCKET",
    },
  ],
}
