#!/bin/sh
# =============================================================================
# post-commit hook: Trigger AI Code Review script
# =============================================================================

# 读取根目录 .env 中的环境变量（若有）
if [ -f ".env" ]; then
  export $(grep -v '^#' .env | xargs 2>/dev/null) 2>/dev/null
fi

if [ -n "$AI_BASE_URL" ] && [ -n "$AI_KEY" ]; then
  echo "🔍 Running AI Code Review..."
  npx tsx scripts/code-review.ts
fi
