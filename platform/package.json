{
  "name": "platform-root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:admin": "pnpm --filter @hodor/admin dev",
    "dev:enterprise": "pnpm --filter @hodor/enterprise dev",
    "dev:personal": "pnpm --filter @hodor/personal dev",
    "dev:all": "pnpm -r --parallel dev",
    "build:admin": "pnpm --filter @hodor/admin build",
    "build:enterprise": "pnpm --filter @hodor/enterprise build",
    "build:personal": "pnpm --filter @hodor/personal build",
    "build:all": "pnpm -r build",
    "build": "pnpm run build:all",
    "test:e2e:auth": "playwright test --project=auth --headed",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.node.json",
    "i18n:scan": "node ./scripts/scan-i18n-enhanced.js",
    "i18n:scan:json": "node ./scripts/scan-i18n-enhanced.js --json",
    "format": "prettier --write .",
    "lint": "eslint . --fix"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "lint-staged": "^17.0.2",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^8.0.14"
  }
}
