# Copy this file to .env.playwright.local and replace the example values.
HODOR_E2E_BASE_URL=https://admin.example.com
HODOR_E2E_ALLOWED_ORIGINS=https://admin.example.com,https://api.example.com

# Optional: when set, the read-only smoke test also verifies this device exists.
HODOR_E2E_DEVICE_CLIENT_ID=

# Optional: enable the mocked authentication flow tests against a local test deployment.
HODOR_E2E_MOCK_AUTH=false
