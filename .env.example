# Docker Registry 配置
REGISTRY_URL=registry.com/namespace

# =============================================================================
# AI 代码审查配置 (AI Code Review Configuration)
# =============================================================================
# 大模型 API Base URL (OpenAI 兼容接口)
AI_BASE_URL=https://xxx.com/api/v1

# 大模型 API Key
AI_KEY=your_api_key_here

# 使用的模型名称 (例如: qwen3.5:27b, deepseek-chat, gpt-4o 等)
AI_MODEL=qwen3.5:27b

# [可选] 单次审查允许的最大 Git Diff 字符数 (默认 200000 字符)
AI_MAX_DIFF_BYTES=200000

# [可选] API 请求超时时间 (单位: 毫秒, 默认 120000 即 2分钟)
AI_TIMEOUT_MS=120000

# [可选] 审查报告输出路径 (相对于项目根目录, 默认 docs/code-reviews)
AI_REVIEW_OUTPUT_DIR=docs/code-reviews

# AutoJS6 Node MQTT 结果消费者稳定 clientId（同一环境只运行一个消费者）
AUTOJS6_MQTT_RESULT_CLIENT_ID=hodor-autojs6-result-main

# 设备执行到期后的结果投递宽限期，默认30000毫秒
AUTOJS6_RESULT_GRACE_MS=30000
