{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": [
      "./server/node_modules/@types",
      "./platform/node_modules/@types"
    ]
  },
  "include": ["scripts/**/*"]
}
